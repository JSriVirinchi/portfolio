# Frontend origin allowed to call the API (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# GitHub username (used only by the legacy /api/github/repos endpoint;
# the live site fetches GitHub directly in the browser)
GITHUB_USERNAME=JsriVirinchi

# --- Contact-form email delivery ---
# EMAIL_PROVIDER: log (default for local) | ses | sendgrid | auto
#   log      -> append submissions to app/data/messages.log, no real email (great for local dev)
#   ses      -> Amazon SES (production / all-AWS); EMAIL_FROM must be an SES-verified identity
#   sendgrid -> SendGrid HTTP API (set SENDGRID_API_KEY)
#   auto     -> SES when an AWS region is present (e.g. on Lambda) and no SendGrid key, else log
EMAIL_PROVIDER=log
EMAIL_FROM=portfolio@example.com
EMAIL_FORWARD_TO=virinchi.junuthula@gmail.com

# Production (set as Lambda env vars by the SAM template, not needed locally):
# SES_REGION=us-east-1            # falls back to AWS_REGION on Lambda
# SENDGRID_API_KEY=...            # only if EMAIL_PROVIDER=sendgrid
